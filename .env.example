# =============================================================================
# Harmony Wellness Center — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The app reads .env from the project root on every request.
# NEVER commit .env to version control.
# =============================================================================

# ── Site ─────────────────────────────────────────────────────────────────────
# Base URL path (leave empty if the app lives at the domain root).
# Examples: "" | "/wellness" | "/site"
BASE_URL=

# Public site name shown in the header, footer, and emails
SITE_NAME="Harmony Wellness Center"

# Public contact email shown on the website
SITE_EMAIL="info@harmonywellness.com"

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────────
# On cPanel these are the values from MySQL® Databases.
DB_HOST=localhost
DB_NAME=wellness
DB_USER=root
DB_PASS=

# ── Admin Panel ──────────────────────────────────────────────────────────────
# Default admin login (change the password after first login!)
ADMIN_USERNAME=admin

# Bcrypt hash of the admin password.
# Generate a new hash:  php app/scripts/admin-password.php "YourNewPassword"
# Default password is:  Admin@Harmony2026
ADMIN_PASSWORD_HASH=$2y$12$nqIh1GJFupDA0tWL0VZe9.sMATwOyJPgp5ldhrEktvuhW4yW/8Zy6

# Seconds of inactivity before the admin lock screen appears (0 = disabled)
ADMIN_IDLE_LOCK_SECONDS=0

# Hard server-side session expiry in seconds (30 minutes)
ADMIN_SESSION_TIMEOUT=1800

# Show lock screen immediately when landing on /admin (false = disabled)
ADMIN_LOCK_ON_ENTRY=false

# ── Google OAuth (Admin Login) ──────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add your domain to Authorized JavaScript origins
# 4. Add your callback URL to Authorized redirect URIs:
#    https://yourdomain.com/admin/google-callback
# 5. Copy the Client ID and Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google email addresses allowed to log in as admin.
# Leave empty to allow any Google account (not recommended for production).
# Example: admin@harmonywellness.com,manager@harmonywellness.com
GOOGLE_ALLOWED_EMAILS=

# ── Email — Resend API ───────────────────────────────────────────────────────
# 1. Sign up free at https://resend.com  (3,000 emails/month)
# 2. Create an API key and paste it below.
# 3. For testing you can leave MAILER_FROM as onboarding@resend.dev.
# 4. For production, verify your domain in Resend and update MAILER_FROM.
RESEND_API_KEY=

# From-address for outgoing emails (must be on a verified Resend domain for prod)
MAILER_FROM=onboarding@resend.dev

# Display name shown as the sender
MAILER_FROM_NAME="Harmony Wellness Center"

# Where new-appointment and QR-payment notification emails are sent
ADMIN_NOTIFY_EMAIL=info@harmonywellness.com

# ── Caching & Debug ──────────────────────────────────────────────────────────
# Set to false in production to let browsers cache CSS/JS aggressively
AUTO_CLEAR_CACHE=true

# Show PHP errors in the browser (true on localhost, false in production)
# Leave unset — the app auto-detects localhost and sets this for you.
# APP_DEBUG=false
