# Block script execution and directory listing in the uploads folder
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
Options -Indexes

# Uploaded files must not be sniffed into HTML: force a strict MIME so a
# poisoned file cannot execute in a visitor's browser.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Serve media with the correct Content-Type (the site sends X-Content-Type-Options: nosniff,
# so browsers refuse to play files whose MIME type is missing or wrong).
AddType video/mp4 .mp4 .m4v
AddType video/webm .webm
AddType video/ogg .ogv
AddType audio/mpeg .mp3

# WebP and AVIF image support
AddType image/webp .webp
AddType image/avif .avif

# Cache optimized images aggressively (they rarely change)
<IfModule mod_expires.c>
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
</IfModule>
